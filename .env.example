# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# These same five variables must also be set in Vercel's project settings.
# None of them may ever be prefixed NEXT_PUBLIC_ -- that prefix ships a value
# to the browser, where anyone can read it.

# --- Neon PostgreSQL -------------------------------------------------------
# From the Neon dashboard.
# DATABASE_URL        direct connection, used by migrations
# DATABASE_URL_POOLED pooled connection, used by the running app
DATABASE_URL=
DATABASE_URL_POOLED=

# --- Better Auth -----------------------------------------------------------
# BETTER_AUTH_SECRET signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs every user out.
BETTER_AUTH_SECRET=

# The app's own URL. http://localhost:3000 locally; the real domain in
# production. A wrong value here breaks sign-in.
BETTER_AUTH_URL=http://localhost:3000

# --- Envelope encryption (proposal 8.1) ------------------------------------
# The master key that wraps every store's own key. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: if this is lost, every store's encrypted data becomes permanently
# unreadable. There is no recovery path -- that is the point of it. Production
# and development should use DIFFERENT master keys.
MASTER_KEY=
